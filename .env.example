# Infrastructure
JOB_PLATFORM_DB=job_platform
JOB_CRAWLER_DB=job_crawler
RECOMMENDATION_DB=jobbeacon_recommendation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_JOB_INDEX=jobs
# Neo4j (recommendation graph). Password must be at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobbeacon
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_MAX=1G

# Shared secret for service-to-service calls to the backend's /internal API (recommendation -> backend).
INTERNAL_API_TOKEN=change_this_internal_token

# Backend
BACKEND_IMAGE=jobbeacon/backend:latest
GATEWAY_PORT=8088
FIREBASE_PROJECT_ID=your_project_id
GATEWAY_INTERNAL_SECRET=change_this_gateway_secret
PROFILE_ACTIVE=prod
CORS_ORIGINS=http://localhost:3000
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
LOKI_URL=http://loki:3100/loki/api/v1/push
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536
CATEGORY_CLASSIFICATION_MIN_SCORE=0.72
CATEGORY_CLASSIFICATION_MIN_MARGIN=0.03

# Recommendation: interactions, the Neo4j graph and its projection. Streams the backend's graph_sync_outbox.
RECOMMENDATION_IMAGE=jobbeacon/recommendation:latest
RECOMMENDATION_PORT=8083
GRAPH_CDC_SLOT_NAME=jobbeacon_graph
GRAPH_CDC_PUBLICATION_NAME=jobbeacon_graph
# How often pending changes are pushed to the graph and the recommendation projection is rebuilt.
GRAPH_REFRESH_INTERVAL=PT15M
# Interactions not repeated within this window no longer affect recommendations.
GRAPH_INTERACTION_WINDOW=P180D
# Loads existing jobs and candidates, but only into an empty graph, so it is safe to leave on.
GRAPH_BACKFILL_ON_STARTUP=true

# Frontend
FRONTEND_IMAGE=jobbeacon/frontend:latest
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8088
VITE_RECOMMENDATION_API_BASE_URL=http://localhost:8083
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Sync: Postgres outbox to Elasticsearch. Host port 8082 leaves 8081 for the crawler.
SYNC_IMAGE=jobbeacon/sync:latest
SYNC_PORT=8082
SYNC_MODE=stream
SYNC_SLOT_NAME=jobbeacon_search
SYNC_PUBLICATION_NAME=jobbeacon_search

# Crawler
CRAWLER_IMAGE=jobbeacon/crawler:latest
CRAWLER_PORT=8081
CRAWLER_LIQUIBASE_ENABLED=true
REDIS_PASSWORD=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROXIES=
CRAWLER_WORKER_POOL_SIZE=1
CRAWLER_MAX_DEPTH=5

LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

BLOOM_FILTER_NAME=crawler:urls

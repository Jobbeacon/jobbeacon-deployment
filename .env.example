# Local: the defaults below work as is (`docker compose up -d --build`).
# VM: change the values marked [VM]. *_IMAGE point at the :latest tag on GHCR, which CI pushes on every push to main.
# Never commit the real .env.

# Infrastructure
JOB_PLATFORM_DB=job_platform
JOB_CRAWLER_DB=job_crawler
RECOMMENDATION_DB=jobbeacon_recommendation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_JOB_INDEX=jobs
# Elasticsearch JVM heap (-Xms and -Xmx). [VM] 1g on a 16GB VM.
ELASTICSEARCH_HEAP=512m
# Neo4j (recommendation graph). Password must be at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobbeacon
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Heap holds the GDS projection; page cache holds the graph store. Without a page cache size Neo4j takes about half
# of the free RAM.
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# Discovery (Eureka). Every Spring service registers at EUREKA_URL; the recommendation service calls the backend by
# its registered name BACKEND_SERVICE_ID (the backend's spring.application.name) through Feign.
# [VM] ghcr.io/<owner>/jobbeacon-discovery:latest
DISCOVERY_IMAGE=jobbeacon/discovery:latest
DISCOVERY_PORT=8761
EUREKA_URL=http://discovery:8761/eureka/
BACKEND_SERVICE_ID=jobbeacon-be

# Backend
# [VM] ghcr.io/<owner>/jobbeacon-be:latest
BACKEND_IMAGE=jobbeacon/backend:latest

# Gateway
# [VM] ghcr.io/<owner>/jobbeacon-gateway:latest
GATEWAY_IMAGE=jobbeacon/gateway:latest
GATEWAY_PORT=8088
FIREBASE_PROJECT_ID=your_project_id
PROFILE_ACTIVE=prod
# [VM] the public origin users open, e.g. http://<VM external IP> or https://<domain>
CORS_ORIGINS=http://localhost:3000
LOKI_URL=http://loki:3100/loki/api/v1/push
GEMINI_API_KEY=
# crawler: discover HTML XPaths with Gemini (uses GEMINI_API_KEY) for domains without configuration
CRAWLER_STRUCTURE_DISCOVERY_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536
# Model behind the chat assistant.
# LLM models, best first: every key is tried before the next model
GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
CATEGORY_CLASSIFICATION_MIN_SCORE=0.72
CATEGORY_CLASSIFICATION_MIN_MARGIN=0.03
# Writes every job to job_search_outbox on startup, so sync re-indexes all of them into Elasticsearch. Turn it on for
# one restart (first deploy, or after the index was lost), then back to false: every CI deploy restarts the backend.
SEARCH_BACKFILL_ON_STARTUP=false
# Embeds CVs, desired titles and open jobs in the background (Gemini, GEMINI_EMBEDDING_MODEL) so that recommendations
# can compare them by meaning. The first run after deploying embeds every open job, then only new or changed ones.
SEMANTIC_MATCHING_ENABLED=true
# Pause between two runs, and how many CVs and jobs each run embeds.
SEMANTIC_MATCHING_INTERVAL=PT30S
SEMANTIC_MATCHING_BATCH_SIZE=50

# Recommendation: interactions, the Neo4j graph and its projection. Streams the backend's graph_sync_outbox.
# [VM] ghcr.io/<owner>/jobbeacon-recommendation:latest
RECOMMENDATION_IMAGE=jobbeacon/recommendation:latest
RECOMMENDATION_PORT=8083
GRAPH_CDC_SLOT_NAME=jobbeacon_graph
GRAPH_CDC_PUBLICATION_NAME=jobbeacon_graph
# How often pending changes are pushed to the graph and the recommendation projection is rebuilt.
GRAPH_REFRESH_INTERVAL=PT15M
# Interactions not repeated within this window no longer affect recommendations.
GRAPH_INTERACTION_WINDOW=P180D
# Loads existing jobs and candidates, but only into an empty graph, so it is safe to leave on.
GRAPH_BACKFILL_ON_STARTUP=true
# Number of jobs a user's recommendations are drawn from.
RECOMMENDATION_POOL_SIZE=100
# How much each reload reshuffles them: 0 = plain ranking, 1 = in proportion to the score.
RECOMMENDATION_SAMPLING_TEMPERATURE=0.5
# How long a job stays hidden after the user followed its apply link.
RECOMMENDATION_APPLIED_HIDDEN_FOR=P14D
# Jobs the backend finds by title words and by meaning (at most 200 each), fused with the graph ranking.
RECOMMENDATION_TITLE_POOL_SIZE=50
RECOMMENDATION_SEMANTIC_POOL_SIZE=100
# Reciprocal Rank Fusion: each source adds weight / (k + rank); a weight of 0 leaves the source out.
RECOMMENDATION_FUSION_K=10
RECOMMENDATION_GRAPH_WEIGHT=1.0
RECOMMENDATION_TITLE_WEIGHT=2.0
RECOMMENDATION_SEMANTIC_WEIGHT=2.0
# WAL a stopped CDC consumer may hold back before its replication slot is dropped. Keep it well under the free disk.
POSTGRES_MAX_SLOT_WAL=4GB

# Frontend
# [VM] ghcr.io/<owner>/jobbeacon-fe:latest
FRONTEND_IMAGE=jobbeacon/frontend:latest
# Every other port binds to 127.0.0.1. [VM] FRONTEND_BIND=0.0.0.0 and FRONTEND_PORT=80 to serve the site publicly.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
# Same image/container, admin site on its own port — keep this one behind the SSH tunnel even on
# the VM (no public FRONTEND_ADMIN_BIND=0.0.0.0) unless the admin site has its own auth story for that.
FRONTEND_ADMIN_BIND=127.0.0.1
FRONTEND_ADMIN_PORT=3002
# [VM] same as CORS_ORIGINS: the frontend's nginx proxies /jobbeacon-be/ to the gateway, so the gateway stays private.
VITE_API_BASE_URL=http://localhost:8088
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Admin only: "view on site" links and the embedded Grafana dashboards page. Empty hides each.
VITE_USER_SITE_URL=
VITE_GRAFANA_URL=http://localhost:3001

# Sync: Postgres outbox to Elasticsearch. Host port 8082 leaves 8081 for the crawler.
# [VM] ghcr.io/<owner>/jobbeacon-sync:latest
SYNC_IMAGE=jobbeacon/sync:latest
SYNC_PORT=8082
SYNC_MODE=stream
SYNC_SLOT_NAME=jobbeacon_search
SYNC_PUBLICATION_NAME=jobbeacon_search

# Crawler
# [VM] ghcr.io/<owner>/job-posting-crawler:latest
CRAWLER_IMAGE=jobbeacon/crawler:latest
CRAWLER_PORT=8081
CRAWLER_LIQUIBASE_ENABLED=true
REDIS_PASSWORD=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROXIES=
CRAWLER_WORKER_POOL_SIZE=1
CRAWLER_MAX_DEPTH=5

# Extra JVM flags per service, appended to JAVA_TOOL_OPTIONS. Without -Xmx each JVM may grow to 1/4 of the machine's
# RAM, and six of them don't fit. Sized for a 16GB VM: about 3.5GB of heap, ~5GB with JVM overhead. Leave them empty
# locally if you prefer the JVM default. ExitOnOutOfMemoryError makes a service that runs out of heap exit, so Docker
# restarts it, instead of staying up half broken.
DISCOVERY_JAVA_OPTS=-Xmx256m -XX:+ExitOnOutOfMemoryError
BACKEND_JAVA_OPTS=-Xmx1g -XX:+ExitOnOutOfMemoryError
GATEWAY_JAVA_OPTS=-Xmx384m -XX:+ExitOnOutOfMemoryError
CRAWLER_JAVA_OPTS=-Xmx768m -XX:+ExitOnOutOfMemoryError
SYNC_JAVA_OPTS=-Xmx384m -XX:+ExitOnOutOfMemoryError
RECOMMENDATION_JAVA_OPTS=-Xmx768m -XX:+ExitOnOutOfMemoryError

LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# [VM] change it
GRAFANA_ADMIN_PASSWORD=admin

BLOOM_FILTER_NAME=crawler:urls

# Infrastructure
JOB_PLATFORM_DB=job_platform
JOB_CRAWLER_DB=job_crawler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_JOB_INDEX=jobs
# Neo4j (recommendation graph). Password must be at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobbeacon
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_MAX=1G
GRAPH_ENABLED=true
GRAPH_POLL_INTERVAL=PT5S
# Set to true for one startup when first enabling the graph, to load jobs that already exist.
GRAPH_BACKFILL_ON_STARTUP=false

# Backend
BACKEND_IMAGE=jobbeacon/backend:latest
BACKEND_PORT=8080
PROFILE_ACTIVE=prod
CORS_ORIGINS=http://localhost:3000
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
LOKI_URL=http://loki:3100/loki/api/v1/push
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=1536
CATEGORY_CLASSIFICATION_MIN_SCORE=0.72
CATEGORY_CLASSIFICATION_MIN_MARGIN=0.03

# Frontend
FRONTEND_IMAGE=jobbeacon/frontend:latest
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Sync: Postgres outbox to Elasticsearch. Host port 8082 leaves 8081 for the crawler.
SYNC_IMAGE=jobbeacon/sync:latest
SYNC_PORT=8082
SYNC_MODE=stream
SYNC_SLOT_NAME=jobbeacon_search
SYNC_PUBLICATION_NAME=jobbeacon_search

# Crawler
CRAWLER_IMAGE=jobbeacon/crawler:latest
CRAWLER_PORT=8081
CRAWLER_LIQUIBASE_ENABLED=true
REDIS_PASSWORD=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROXIES=
CRAWLER_WORKER_POOL_SIZE=1
CRAWLER_MAX_DEPTH=5

LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

BLOOM_FILTER_NAME=crawler:urls
